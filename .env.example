# --- Database ---
POSTGRES_DB=meridian
POSTGRES_USER=meridian
POSTGRES_PASSWORD=changeme_in_production

# --- GitHub API ---
# Create a personal access token at https://github.com/settings/tokens
# Scopes needed: public_repo (read-only is enough)
GITHUB_TOKEN=ghp_your_token_here

# --- Collector ---
COLLECT_INTERVAL_HOURS=6
REPOS_PER_LANGUAGE=100
# Comma-separated list of languages to collect
LANGUAGES=python,javascript,typescript,go,rust

# --- AI (optional) ---
AI_ENABLED=false
GEMINI_API_KEY=
AI_TOP_REPOS_PER_LANGUAGE=20

# --- Job market (Adzuna + RemoteOK, optional) ---
# Adzuna: registre uma conta gratuita em https://developer.adzuna.com para obter app_id/app_key
# RemoteOK não precisa de credenciais.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=br
MARKET_COLLECT_INTERVAL_HOURS=24

# --- App ---
LOG_LEVEL=INFO
